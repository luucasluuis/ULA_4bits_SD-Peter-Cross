NET "input<0>" LOC = "V8"  | IOSTANDARD = LVCMOS33 ;
NET "input<1>" LOC = "U10" | IOSTANDARD = LVCMOS33 ;
NET "input<2>" LOC = "U8"  | IOSTANDARD = LVCMOS33 ;
NET "input<3>" LOC = "T9"  | IOSTANDARD = LVCMOS33 ;

NET "button" LOC = "T16" | IOSTANDARD = LVCMOS33 | PULLDOWN ;
NET "reset"  LOC = "U15" | IOSTANDARD = LVCMOS33 | PULLDOWN ;

NET "output<0>" LOC = "R20" | IOSTANDARD = LVCMOS33 | SLEW = SLOW | DRIVE = 8 ;
NET "output<1>" LOC = "T19" | IOSTANDARD = LVCMOS33 | SLEW = SLOW | DRIVE = 8 ;
NET "output<2>" LOC = "U20" | IOSTANDARD = LVCMOS33 | SLEW = SLOW | DRIVE = 8 ;
NET "output<3>" LOC = "U19" | IOSTANDARD = LVCMOS33 | SLEW = SLOW | DRIVE = 8 ;
NET "Zero"      LOC = "V19" | IOSTANDARD = LVCMOS33 | SLEW = SLOW | DRIVE = 8 ;
NET "Negative"  LOC = "V20" | IOSTANDARD = LVCMOS33 | SLEW = SLOW | DRIVE = 8 ;
NET "Cout"      LOC = "Y22" | IOSTANDARD = LVCMOS33 | SLEW = SLOW | DRIVE = 8 ;
NET "Overflow"  LOC = "W21" | IOSTANDARD = LVCMOS33 | SLEW = SLOW | DRIVE = 8 ;